# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://notification_user:notification_password@localhost:5432/notification_engine

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-engine
KAFKA_GROUP_ID=notification-service

# RabbitMQ
RABBITMQ_URL=amqp://notification_user:notification_password@localhost:5672

# JWT
JWT_SECRET=change-me-in-development
JWT_ACCESS_TOKEN_TTL=1h

# Application
LOG_LEVEL=debug

# Twilio
TWILIO_ACCOUNT_SID=your_test_account_sid
TWILIO_AUTH_TOKEN=your_test_auth_token
TWILIO_FROM_PHONE=+15005550006

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/firebase-service-account.json

WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# SMTP and DLQ operations alerts

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_GMAIL@gmail.com
SMTP_PASSWORD=PASTE_THE_16_CHARACTER_APP_PASSWORD_HERE
SMTP_FROM="ZeTheta Operations <YOUR_GMAIL@gmail.com>"

OPS_ALERT_EMAIL=YOUR_GMAIL@gmail.com
DLQ_ALERT_THRESHOLD=100
