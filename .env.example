# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://notification_user:notification_password@localhost:5432/notification_engine

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-engine
KAFKA_GROUP_ID=notification-service

# RabbitMQ
RABBITMQ_URL=amqp://notification_user:notification_password@localhost:5672

# JWT
JWT_SECRET=change-me-in-development
JWT_ACCESS_TOKEN_TTL=1h

# Application
LOG_LEVEL=debug