generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  phone              String                   @unique
  email              String                   @unique
  name               String?
  language           String                   @default("en")
  timezone           String                   @default("Asia/Kolkata")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  segment            String                   @default("STANDARD")
  consentRecords     ConsentRecord[]
  consentAuditLogs   ConsentAuditLog[]
  quietHoursBypassAuditLogs QuietHoursBypassAuditLog[]
  notifications      Notification[]
  channelPerformance UserChannelPerformance[]
  preferences        UserPreference[]
}

model UserChannelPerformance {
  userId           String              @db.Uuid
  channel          NotificationChannel
  deliveryRate     Float               @default(0.5)
  averageLatencyMs Int                 @default(1000)
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channel])
}

model Notification {
  id                  String                 @default(uuid()) @db.Uuid
  createdAt           DateTime               @default(now())
  eventType           String                 @db.VarChar(30)
  eventId             String                 @db.VarChar(50)
  userId              String                 @db.Uuid
  channel             NotificationChannel
  priority            Int                    @default(5)
  status              NotificationStatus     @default(CREATED)
  templateId          String                 @db.VarChar(50)
  templateVersion     Int
  personalizationData Json
  renderedContent     Json?
  provider            String?                @db.VarChar(30)
  externalId          String?                @db.VarChar(100)
  deliveryAttempts    Int                    @default(0)
  maxRetries          Int                    @default(3)
  nextRetryAt         DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  failedReason        String?
  costPaisa           Int?
  metadata            Json?
  updatedAt           DateTime               @updatedAt
  deliveryProviderId  String?                @db.Uuid
  deadLetterEntries   DeadLetterQueue[]
  deliveryProvider    DeliveryProvider?      @relation(fields: [deliveryProviderId], references: [id])
  user                User                   @relation(fields: [userId], references: [id])
  stateLogs           NotificationStateLog[]
  deliveryAcknowledgements DeliveryAcknowledgement[]

  @@id([id, createdAt])
  @@index([userId, status, channel])
  @@index([eventType, createdAt])
  @@index([status], map: "Notification_queued_retrying_status_idx", where: raw("(status = ANY (ARRAY['QUEUED'::\"NotificationStatus\", 'RETRYING'::\"NotificationStatus\"]))"))
  @@index([createdAt], map: "Notification_createdAt_brin_idx", type: Brin)
  @@index([personalizationData], map: "Notification_personalizationData_gin_idx", type: Gin)
}

model DeliveryAcknowledgement {
  id                    String             @id @default(uuid()) @db.Uuid
  provider              String             @db.VarChar(50)
  callbackId            String             @db.VarChar(191)
  externalId            String             @db.VarChar(100)
  providerStatus        String             @db.VarChar(50)
  status                NotificationStatus
  occurredAt            DateTime
  payload               Json?
  notificationId        String?            @db.Uuid
  notificationCreatedAt DateTime?
  createdAt             DateTime           @default(now())
  notification          Notification?      @relation(fields: [notificationId, notificationCreatedAt], references: [id, createdAt], onDelete: SetNull)

  @@unique([provider, callbackId])
  @@index([provider, externalId])
  @@index([notificationId])
  @@index([createdAt])
}

model NotificationStateLog {
  id                    BigInt              @id @default(autoincrement())
  notificationId        String              @db.Uuid
  notificationCreatedAt DateTime
  fromStatus            NotificationStatus?
  toStatus              NotificationStatus
  actor                 String              @db.VarChar(50)
  metadata              Json?
  createdAt             DateTime            @default(now())
  notification          Notification        @relation(fields: [notificationId, notificationCreatedAt], references: [id, createdAt])

  @@index([notificationId])
  @@index([createdAt])
}

model DeadLetterQueue {
  id                    String       @id @default(uuid()) @db.Uuid
  notificationId        String       @db.Uuid
  notificationCreatedAt DateTime
  originalEvent         Json
  failureReason         String
  retryCount            Int
  lastError             String?
  resolved              Boolean      @default(false)
  resolvedBy            String?      @db.VarChar(50)
  resolvedAt            DateTime?
  resolutionAction      String?      @db.VarChar(50)
  createdAt             DateTime     @default(now())
  notification          Notification @relation(fields: [notificationId, notificationCreatedAt], references: [id, createdAt])
}

model UserPreference {
  userId             String              @db.Uuid
  eventCategory      String              @db.VarChar(30)
  eventType          String              @default("*") @db.VarChar(50)
  channel            NotificationChannel
  enabled            Boolean             @default(true)
  quietHoursOverride Boolean             @default(false)
  digestMode         String              @default("immediate") @db.VarChar(20)
  priorityOverride   Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id])

  @@id([userId, eventCategory, eventType, channel])
}

model Template {
  id            String              @id @default(uuid()) @db.Uuid
  templateKey   String
  eventType     String
  channel       NotificationChannel
  language      String              @default("en")
  version       Int
  requiredFields String[]            @default([])
  content       String
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  experimentKey String?
  variant       String?
  variantWeight Int                 @default(100)

  @@unique([templateKey, channel, language, version])
  @@index([eventType, channel, language])
  @@index([experimentKey, variant])
}

model DeliveryProvider {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  channel         ProviderChannel
  endpoint        String?
  active          Boolean         @default(true)
  rateLimitPerSec Int?
  priority        Int             @default(1)
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  notifications   Notification[]

  @@index([channel, active, priority])
}

model ConsentRecord {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  consentType ConsentType
  granted     Boolean     @default(false)
  source      String?
  grantedAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])

  @@index([userId, consentType])
}

model ConsentAuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  consentType ConsentType
  previousGranted Boolean?
  granted     Boolean
  source      String?     @db.VarChar(100)
  action      String      @db.VarChar(20)
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, consentType, createdAt])
  @@index([createdAt])
}

model QuietHoursBypassAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @db.Uuid
  eventId        String   @db.VarChar(50)
  eventType      String   @db.VarChar(30)
  userId         String   @db.Uuid
  priority       String   @db.VarChar(20)
  timezone       String   @db.VarChar(50)
  localTime      String   @db.VarChar(5)
  quietHoursStart String  @db.VarChar(5)
  quietHoursEnd  String   @db.VarChar(5)
  reason         String   @db.VarChar(100)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([notificationId])
  @@index([createdAt])
}

enum NotificationStatus {
  CREATED
  ENRICHED
  ROUTED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RETRYING
  BOUNCED
  DLQ
  CAPPED
  QUIET
  DND
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
  WHATSAPP
  IN_APP
}

enum ConsentType {
  TRANSACTIONAL
  PROMOTIONAL
  MARKETING
}

enum ProviderChannel {
  SMS
  EMAIL
  PUSH
  WHATSAPP
  IN_APP
}
